# RepoRover configuration
# Copy this to config.yaml and fill in your credentials.
# Do NOT commit config.yaml or any file containing secrets.

# Provider selection: "github", "gitlab", or "both".
# "both" runs GitHub and GitLab side by side; each repository is routed to the
# provider that owns it (probed GitHub-first) and requires both tokens.
provider: "github"

# GitHub Configuration
github:
  token: ""  # Personal access token or fine-grained token
  base_url: "https://api.github.com"  # For GitHub Enterprise
  # Required permissions:
  # - repo (read/write)
  # - issues (read/write)
  # - pull_requests (read/write)
  # - contents (read)
  # - metadata (read)

# GitLab Configuration
gitlab:
  token: ""  # Personal access token
  url: "https://gitlab.com"  # For self-hosted GitLab
  # Required permissions:
  # - api (read/write)
  # - read_repository
  # - write_repository

# Label Configuration
labels:
  eligible: "agent"           # Issues with this label are eligible for autonomous work
  in_progress: "doing"        # Work is currently active
  stuck: "stuck"              # Human input required
  awaiting_review: "awaiting review"  # Ready for human review

# Repository Configuration
repositories:
  # Explicit owner/repo entries to monitor. An empty list disables discovery
  # (there is no "discover all accessible repositories" mode).
  - "owner/repo1"
  # - "owner/repo2"

# Polling Configuration
polling:
  interval_seconds: 60  # How often to check for new eligible issues
  max_issues_per_poll: 50

# Retry Configuration
retry:
  max_attempts: 3
  base_delay_seconds: 2
  max_delay_seconds: 60
  exponential_base: 2

# OpenCode service (the agent that performs the coding work)
opencode:
  api_url: "http://opencode:8080"
  timeout: 300  # seconds per request
  max_concurrent: 1  # reserved; concurrency is not yet enabled
  # The server uses HTTP Basic auth with user "opencode". Provide the password
  # via the OPENCODE_SERVER_PASSWORD environment variable instead of this file.
  # password: ""

# State persistence
state:
  state_dir: "/data/state"
  max_history: 1000

log_level: "INFO"